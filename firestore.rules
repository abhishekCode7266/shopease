rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || request.auth.token.admin == true);
    }

    function isSeller() {
      return isAuthenticated() && (getUserData().role == 'seller' || isAdmin());
    }

    function isDeliveryPartner() {
      return isAuthenticated() && (getUserData().role == 'delivery' || isAdmin());
    }

    // Products catalog:
    // Anyone can read products. Verified sellers and admins can create/update.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || (isSeller() && resource.data.sellerId == request.auth.uid);
    }

    // Categories catalog:
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Marketplace site settings:
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promotional coupons:
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Product reviews:
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Delivery and logistics assignments:
    match /deliveries/{deliveryId} {
      allow read: if isAuthenticated();
      allow write: if isDeliveryPartner() || isSeller() || isAdmin();
    }

    // Seller KYC applications:
    match /seller_applications/{appId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // User profile documents & subcollections:
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // Cart sub-collection:
      match /cart/{cartItemId} {
        allow read, write: if isOwner(userId);
      }

      // Orders sub-collection:
      match /orders/{orderId} {
        allow read: if isOwner(userId) || isSeller() || isDeliveryPartner() || isAdmin();
        allow write: if isOwner(userId) || isSeller() || isDeliveryPartner() || isAdmin();
      }
    }
  }
}
